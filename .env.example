ANTHROPIC_API_KEY=your-anthropic-api-key-here
MERGE_API_KEY=your-merge-api-key-here
DATABASE_URL=file:./dev.db

# BlueBubbles Server — self-hosted, runs locally on this Mac. See
# scripts/bluebubbles-install.sh. URL is the local server (default port
# 1234); password is whatever you set during install/setup.
BLUEBUBBLES_SERVER_URL=http://127.0.0.1:1234
BLUEBUBBLES_SERVER_PASSWORD=your-bluebubbles-server-password-here

# Only needed to run scripts/persona-relay.ts (the live multi-device demo
# helper) — the real group chat GUID, same value on every machine in the
# demo. Find it by running `pnpm bluebubbles:listen` and sending any message
# into the target chat; copy the `chat` field it logs.
DEMO_GROUP_CHAT_GUID=
